{
    "openapi": "3.0.3",
    "info": {
        "title": "PetMatch Rails API",
        "description": "API backend completa para la plataforma de adopción y gestión de refugios.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:3000/api/v1",
            "description": "Servidor de Desarrollo Local"
        }
    ],
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        },
        "parameters": {
            "AcceptLanguage": {
                "name": "Accept-Language",
                "in": "header",
                "required": false,
                "schema": {
                    "type": "string",
                    "enum": [
                        "es",
                        "en"
                    ],
                    "default": "es"
                }
            }
        }
    },
    "paths": {
        "/enums": {
            "get": {
                "tags": [
                    "Auxiliares"
                ],
                "summary": "Obtener metadatos y enumerados",
                "responses": {
                    "200": {
                        "description": "Enums anidados por modelo"
                    }
                }
            }
        },
        "/signup": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Registro de usuario",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/AcceptLanguage"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "first_name": {
                                        "type": "string",
                                        "example": "Santiago"
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "example": "Matheu"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "santiago@test.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "+542211234567"
                                    },
                                    "address": {
                                        "type": "object",
                                        "properties": {
                                            "street": {
                                                "type": "string",
                                                "example": "Calle 7"
                                            },
                                            "number": {
                                                "type": "string",
                                                "example": "850"
                                            },
                                            "city_id": {
                                                "type": "integer",
                                                "example": 1
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuario creado"
                    }
                }
            }
        },
        "/login": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Iniciar sesión",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "santiago@test.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login exitoso"
                    }
                }
            }
        },
        "/logout": {
            "delete": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Cerrar sesión",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Sesión cerrada correctamente"
                    }
                }
            }
        },
        "/profile": {
            "get": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Ver perfil de usuario autenticado",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Datos del perfil"
                    }
                }
            },
            "put": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Actualizar perfil de usuario",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "first_name": {
                                        "type": "string"
                                    },
                                    "last_name": {
                                        "type": "string"
                                    },
                                    "phone": {
                                        "type": "string"
                                    },
                                    "address": {
                                        "type": "object",
                                        "properties": {
                                            "street": {
                                                "type": "string"
                                            },
                                            "number": {
                                                "type": "string"
                                            },
                                            "city_id": {
                                                "type": "integer"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Perfil actualizado"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Desactivar cuenta (Soft Delete)",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/AcceptLanguage"
                    }
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cuenta desactivada"
                    }
                }
            }
        },
        "/pets": {
            "get": {
                "tags": [
                    "Mascotas"
                ],
                "summary": "Listar mascotas disponibles con filtros",
                "parameters": [
                    {
                        "name": "species",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "breed_id",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "gender",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "city_id",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "shelter_id",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Listado de mascotas"
                    }
                }
            }
        },
        "/pets/{id}": {
            "get": {
                "tags": [
                    "Mascotas"
                ],
                "summary": "Detalle de una mascota con ficha médica",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Detalle de la mascota"
                    }
                }
            }
        },
        "/favorites": {
            "get": {
                "tags": [
                    "Favoritos"
                ],
                "summary": "Listar mascotas favoritas del usuario",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de favoritos"
                    }
                }
            },
            "post": {
                "tags": [
                    "Favoritos"
                ],
                "summary": "Agregar mascota a favoritos",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "pet_id": {
                                        "type": "integer",
                                        "example": 1
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Agregado a favoritos"
                    }
                }
            }
        },
        "/favorites/{id}": {
            "delete": {
                "tags": [
                    "Favoritos"
                ],
                "summary": "Quitar de favoritos (por ID de favorito o ID de mascota)",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Eliminado de favoritos"
                    }
                }
            }
        },
        "/adoption_applications": {
            "get": {
                "tags": [
                    "Adopciones"
                ],
                "summary": "Listar postulaciones del usuario",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de solicitudes"
                    }
                }
            },
            "post": {
                "tags": [
                    "Adopciones"
                ],
                "summary": "Crear nueva postulación",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/AcceptLanguage"
                    }
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "pet_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "housing_type": {
                                        "type": "string",
                                        "example": "house"
                                    },
                                    "has_another_pet": {
                                        "type": "boolean",
                                        "example": false
                                    },
                                    "notes": {
                                        "type": "string",
                                        "example": "Tengo patio cerrado"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Solicitud creada"
                    }
                }
            }
        },
        "/adoption_applications/{id}": {
            "put": {
                "tags": [
                    "Adopciones"
                ],
                "summary": "Editar datos de postulación (solo si está pendiente)",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "housing_type": {
                                        "type": "string"
                                    },
                                    "has_another_pet": {
                                        "type": "boolean"
                                    },
                                    "notes": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Solicitud actualizada"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Adopciones"
                ],
                "summary": "Cancelar postulación",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Solicitud cancelada"
                    }
                }
            }
        },
        "/shelters": {
            "get": {
                "tags": [
                    "Catálogos Auxiliares"
                ],
                "summary": "Listar refugios activos",
                "responses": {
                    "200": {
                        "description": "Listado de refugios"
                    }
                }
            }
        },
        "/shelters/{id}": {
            "get": {
                "tags": [
                    "Catálogos Auxiliares"
                ],
                "summary": "Detalle detallado de un refugio",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Detalle del refugio"
                    }
                }
            }
        },
        "/cities": {
            "get": {
                "tags": [
                    "Catálogos Auxiliares"
                ],
                "summary": "Listar ciudades disponibles",
                "responses": {
                    "200": {
                        "description": "Listado de ciudades"
                    }
                }
            }
        },
        "/breeds": {
            "get": {
                "tags": [
                    "Catálogos Auxiliares"
                ],
                "summary": "Listar razas disponibles",
                "responses": {
                    "200": {
                        "description": "Listado de razas"
                    }
                }
            }
        }
    }
}