<%# app/views/layouts/admin.html.erb %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full bg-slate-50">
  <head>
    <title><%= yield(:title) || "PetMatch Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full font-sans antialiased text-slate-700 overflow-hidden">
    <!-- Main layout container with fixed screen height -->
    <div class="h-screen flex flex-col md:flex-row overflow-hidden">
      
      <!-- Fixed Sidebar -->
      <aside class="w-full md:w-64 bg-slate-800 text-slate-200 flex-shrink-0 flex flex-col h-full justify-between">
        <div>
          <!-- Logo Header -->
          <div class="p-6 flex items-center gap-3 border-b border-slate-700/60">
            <div class="w-9 h-9 rounded-xl bg-emerald-500 flex items-center justify-center text-white font-bold text-lg shadow-sm">
              🐾
            </div>
            <div>
              <h1 class="font-bold text-slate-100 text-base leading-none">PetMatch</h1>
              <span class="text-xs text-slate-400 font-medium"><%= t('admin.shared.back_office') %></span>
            </div>
          </div>

          <!-- Navigation Links -->
          <nav class="px-4 py-6 space-y-1">
            <%= link_to admin_pets_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium text-sm transition #{current_page?(admin_pets_path) ? 'bg-emerald-600 text-white shadow-sm' : 'text-slate-300 hover:bg-slate-700/50 hover:text-white'}" do %>
              <span>🐶</span> <%= t('admin.shared.pets') %>
            <% end %>

            <%= link_to admin_adoption_applications_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium text-sm transition #{current_page?(admin_adoption_applications_path) ? 'bg-emerald-600 text-white shadow-sm' : 'text-slate-300 hover:bg-slate-700/50 hover:text-white'}" do %>
              <span>📋</span> <%= t('admin.shared.applications') %>
            <% end %>

            <% if current_user.admin? %>
              <%= link_to admin_shelters_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium text-sm transition #{current_page?(admin_shelters_path) ? 'bg-emerald-600 text-white shadow-sm' : 'text-slate-300 hover:bg-slate-700/50 hover:text-white'}" do %>
                <span>🏠</span> <%= t('admin.shared.shelters') %>
              <% end %>

              <%= link_to admin_users_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium text-sm transition #{current_page?(admin_users_path) ? 'bg-emerald-600 text-white shadow-sm' : 'text-slate-300 hover:bg-slate-700/50 hover:text-white'}" do %>
                <span>👥</span> <%= t('admin.shared.users') %>
              <% end %>
            <% elsif current_user.shelter_manager? %>
              <% if current_user.shelter.present? %>
                <% shelter_edit_path = edit_admin_shelter_path(current_user.shelter) %>
                <%= link_to shelter_edit_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium text-sm transition #{current_page?(shelter_edit_path) ? 'bg-emerald-600 text-white shadow-sm' : 'text-slate-300 hover:bg-slate-700/50 hover:text-white'}" do %>
                  <span>🏠</span> <%= t('admin.shared.my_shelter') %>
                <% end %>
              <% end %>

              <% profile_edit_path = edit_admin_user_path(current_user) %>
              <%= link_to profile_edit_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium text-sm transition #{current_page?(profile_edit_path) ? 'bg-emerald-600 text-white shadow-sm' : 'text-slate-300 hover:bg-slate-700/50 hover:text-white'}" do %>
                <span>👤</span> <%= t('admin.shared.profile') %>
              <% end %>
            <% end %>
          </nav>
        </div>

        <!-- User Footer -->
        <div class="p-4 border-t border-slate-700/60 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-emerald-800 text-emerald-200 flex items-center justify-center font-bold text-xs">
              <%= current_user&.first_name&.first || "A" %>
            </div>
            <div class="text-xs">
              <p class="font-semibold text-slate-200"><%= current_user&.first_name || "Admin" %></p>
              <p class="text-slate-400 capitalize"><%= current_user&.shelter&.name || "Admin" %></p>
            </div>
          </div>
          <%= button_to session_path, method: :delete, class: "text-slate-400 hover:text-rose-400 text-xs font-medium cursor-pointer" do %>
            <%= t('admin.shared.logout') %>
          <% end %>
        </div>
      </aside>

      <!-- Main Content Container with Independent Scroll -->
      <main class="flex-1 flex flex-col min-w-0 h-full overflow-hidden">
        <!-- Topbar -->
        <header class="bg-white border-b border-slate-200/80 px-6 py-4 flex items-center justify-between shadow-sm flex-shrink-0">
          <h2 class="text-lg font-bold text-slate-800">
            <%= yield :page_title %>
          </h2>
          <div class="flex items-center gap-3">
            <!-- Locale Switcher -->
            <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl text-xs font-semibold">
              <%= link_to "ES", url_for(locale: :es), class: "px-2 py-1 rounded-lg transition #{I18n.locale == :es ? 'bg-white text-slate-800 shadow-xs' : 'text-slate-500 hover:text-slate-800'}" %>
              <%= link_to "EN", url_for(locale: :en), class: "px-2 py-1 rounded-lg transition #{I18n.locale == :en ? 'bg-white text-slate-800 shadow-xs' : 'text-slate-500 hover:text-slate-800'}" %>
            </div>

            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <%= t('admin.shared.system_active') %>
            </span>
          </div>
        </header>

        <!-- Scrollable Body Content -->
        <div class="p-6 md:p-8 flex-1 overflow-y-auto">
          <% if flash[:notice] %>
            <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium flex items-center gap-2">
              <span>✅</span> <%= flash[:notice] %>
            </div>
          <% end %>

          <%= yield %>
        </div>
      </main>

    </div>
  </body>
</html>