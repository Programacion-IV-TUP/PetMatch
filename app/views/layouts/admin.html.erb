<!DOCTYPE html>
<html>
  <head>
    <title>PetMatch - Panel de Administración</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-100 flex min-h-screen">
    <!-- Sidebar / Menú Lateral -->
    <aside class="w-64 bg-slate-800 text-white flex flex-col justify-between p-4">
      <div>
        <h1 class="text-xl font-bold mb-6 text-indigo-400">PetMatch Admin</h1>
        <nav class="space-y-2">
          <%= link_to "Mascotas", admin_pets_path, class: "block py-2 px-3 rounded hover:bg-slate-700" %>
          <%= link_to "Solicitudes", admin_adoption_applications_path, class: "block py-2 px-3 rounded hover:bg-slate-700" %>
          
          <% if current_user.admin? %>
            <hr class="border-slate-700 my-3">
            <span class="text-xs uppercase text-slate-400 font-semibold px-3">Gestión Global</span>
            <%= link_to "Refugios", admin_shelters_path, class: "block py-2 px-3 rounded hover:bg-slate-700" %>
            <%= link_to "Ciudades", admin_cities_path, class: "block py-2 px-3 rounded hover:bg-slate-700" %>
            <%= link_to "Razas", admin_breeds_path, class: "block py-2 px-3 rounded hover:bg-slate-700" %>
          <% end %>
        </nav>
      </div>

      <div class="border-t border-slate-700 pt-3 text-sm">
        <p class="font-medium"><%= current_user.email_address %></p>
        <p class="text-slate-400 text-xs uppercase"><%= current_user.role %></p>
        <%= button_to "Cerrar sesión", destroy_user_session_path, method: :delete, class: "mt-2 text-red-400 text-xs hover:underline" %>
      </div>
    </aside>

    <!-- Contenido Principal -->
    <main class="flex-1 p-8">
      <% if flash[:notice].present? %>
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert].present? %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4"><%= flash[:alert] %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>