<% content_for :page_title, t('.title') %>

<div class="space-y-6">
  <!-- Actions Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h3 class="text-xl font-bold text-slate-800"><%= t('.header') %></h3>
      <p class="text-xs text-slate-500 mt-0.5"><%= t('.subtitle') %></p>
    </div>
    
    <%= link_to new_admin_user_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-xl shadow-sm transition cursor-pointer self-start sm:self-auto" do %>
      <span>➕</span> <%= t('.add_manager') %>
    <% end %>
  </div>

  <!-- Search & Filters -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm mb-6">
    <%= form_with url: admin_users_path, method: :get, data: { turbo_frame: "_top" }, class: "flex flex-wrap items-center gap-3" do |f| %>
      <div class="flex-1 min-w-[200px]">
        <%= f.text_field :query, value: params[:query], placeholder: t('.search_placeholder'), class: "w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:ring-emerald-500 focus:border-emerald-500" %>
      </div>

      <div>
        <%= f.select :role, 
                     options_for_select([[t('.all_roles'), '']] + User.roles.keys.map { |r| [t("activerecord.attributes.user/role.#{r}", default: r.humanize), r] }, params[:role]), 
                     {}, 
                     class: "px-3 py-2 text-xs rounded-xl border border-slate-200 focus:ring-emerald-500 focus:border-emerald-500 bg-white" %>
      </div>

      <div>
        <%= f.select :active, 
                     options_for_select([
                       [t('.all_records'), ''],
                       [t('.active_only'), 'true'],
                       [t('.inactive_only'), 'false']
                     ], params[:active]), 
                     {}, 
                     class: "px-3 py-2 text-xs rounded-xl border border-slate-200 focus:ring-emerald-500 focus:border-emerald-500 bg-white" %>
      </div>

      <%= f.submit t('.filter_button'), class: "px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white font-semibold text-xs rounded-xl shadow-sm transition cursor-pointer" %>
      
      <% if params[:query].present? || params[:role].present? || params[:active].present? %>
        <%= link_to t('.clear_filters'), admin_users_path, class: "text-xs font-semibold text-rose-600 hover:text-rose-700 transition" %>
      <% end %>
    <% end %>
  </div>

  <!-- Users Table -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-600">
        <thead class="bg-slate-50 text-xs font-semibold text-slate-400 uppercase border-b border-slate-100">
          <tr>
            <th class="px-6 py-3.5"><%= t('.table.name') %></th>
            <th class="px-6 py-3.5"><%= t('.table.email') %></th>
            <th class="px-6 py-3.5 min-w-[160px]"><%= t('.table.role') %></th>
            <th class="px-6 py-3.5"><%= t('.table.shelter') %></th>
            <th class="px-6 py-3.5"><%= t('.table.active_switch') %></th>
            <th class="px-6 py-3.5 text-right"><%= t('.table.actions') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-xs text-slate-700">
          <% if @users.any? %>
            <% @users.each do |user| %>
              <tr class="hover:bg-slate-50/50 transition">
                <td class="py-4 px-6 font-bold text-slate-800">
                  <%= user.full_name %>
                </td>
                <td class="py-4 px-6 text-slate-600">
                  <%= user.email_address %>
                </td>
                <td class="py-4 px-6">
                  <span class="inline-block whitespace-nowrap px-2.5 py-1 rounded-full text-xs font-semibold border <%= user.admin? ? 'bg-purple-50 text-purple-700 border-purple-200' : 'bg-blue-50 text-blue-700 border-blue-200' %>">
                    <%= t("activerecord.attributes.user/role.#{user.role}") %>
                  </span>
                </td>
                <td class="py-4 px-6 text-slate-600">
                  <%= user.shelter&.name || "-" %>
                </td>

                <!-- Interactive Active Toggle Switch -->
                <td class="px-6 py-4">
                  <% if user.active? %>
                    <%= button_to admin_user_path(user, user: { active: false }), 
                                  method: :patch, 
                                  title: t('admin.shared.click_to_deactivate'),
                                  disabled: (user == current_user),
                                  class: "group flex items-center gap-2 focus:outline-none #{user == current_user ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer'}" do %>
                      <div class="w-9 h-5 bg-emerald-500 rounded-full transition-colors relative p-0.5 group-hover:bg-emerald-600 shadow-inner">
                        <div class="w-4 h-4 bg-white rounded-full shadow-md transform translate-x-4 transition-transform"></div>
                      </div>
                      <span class="text-xs font-semibold text-emerald-700 select-none">
                        <%= t('admin.shared.status_active') %>
                      </span>
                    <% end %>
                  <% else %>
                    <%= button_to admin_user_path(user, user: { active: true }), 
                                  method: :patch, 
                                  title: t('admin.shared.click_to_activate'),
                                  class: "group flex items-center gap-2 cursor-pointer focus:outline-none" do %>
                      <div class="w-9 h-5 bg-slate-300 rounded-full transition-colors relative p-0.5 group-hover:bg-slate-400 shadow-inner">
                        <div class="w-4 h-4 bg-white rounded-full shadow-md transform translate-x-0 transition-transform"></div>
                      </div>
                      <span class="text-xs font-semibold text-slate-500 select-none">
                        <%= t('admin.shared.status_inactive') %>
                      </span>
                    <% end %>
                  <% end %>
                </td>

                <!-- Actions -->
                <td class="py-4 px-6 text-right space-x-2">
                  <%= link_to admin_user_path(user), class: "font-semibold text-blue-600 hover:text-blue-700" do %>
                    <%= t('admin.shared.show') %>
                  <% end %>
                  <%= link_to t('admin.shared.edit'), edit_admin_user_path(user), class: "font-semibold text-emerald-600 hover:text-emerald-700" %>
                  <% unless user == current_user %>
                    <%= button_to t('admin.shared.delete'), admin_user_path(user), method: :delete, data: { turbo_confirm: t('.table.confirm_delete', name: user.full_name) }, class: "inline-block font-semibold text-rose-600 hover:text-rose-700 cursor-pointer" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-6 py-8 text-center text-slate-400 text-sm">
                <%= t('.table.no_users') %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <!--Paginate-->
      <%= render 'admin/shared/pagination', pagy: @pagy %>
    </div>
  </div>
</div>