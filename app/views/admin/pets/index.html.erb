<% content_for :page_title, t('.title') %>

<div class="space-y-6">
  <!-- Actions Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h3 class="text-xl font-bold text-slate-800"><%= t('.header') %></h3>
      <p class="text-xs text-slate-500 mt-0.5"><%= t('.subtitle') %></p>
    </div>
    
    <%= link_to new_admin_pet_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-xl shadow-sm transition cursor-pointer self-start sm:self-auto" do %>
      <span>➕</span> <%= t('.add_pet') %>
    <% end %>
  </div>

  <!-- Search & Filters -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm mb-6">
    <%= form_with url: admin_pets_path, method: :get, data: { turbo_frame: "_top" }, class: "flex flex-wrap items-center gap-3" do |f| %>
      <div class="flex-1 min-w-[200px]">
        <%= f.text_field :query, value: params[:query], placeholder: t('.search_placeholder'), class: "w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:ring-emerald-500 focus:border-emerald-500" %>
      </div>

      <div>
        <%= f.select :status, 
                     options_for_select([[t('.all_statuses'), '']] + Pet.statuses.keys.map { |s| [t("activerecord.attributes.pet/status.#{s}", default: s.humanize), s] }, params[:status]), 
                     {}, 
                     class: "px-3 py-2 text-xs rounded-xl border border-slate-200 focus:ring-emerald-500 focus:border-emerald-500 bg-white" %>
      </div>

      <div>
        <%= f.select :active, 
                     options_for_select([
                       [t('.all_records'), ''],
                       [t('.active_only'), 'true'],
                       [t('.inactive_only'), 'false']
                     ], params[:active]), 
                     {}, 
                     class: "px-3 py-2 text-xs rounded-xl border border-slate-200 focus:ring-emerald-500 focus:border-emerald-500 bg-white" %>
      </div>

      <%= f.submit t('.filter_button'), class: "px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white font-semibold text-xs rounded-xl shadow-sm transition cursor-pointer" %>
      
      <% if params[:query].present? || params[:status].present? || params[:active].present? %>
        <%= link_to t('.clear_filters'), admin_pets_path, class: "text-xs font-semibold text-rose-600 hover:text-rose-700 transition" %>
      <% end %>
    <% end %>
  </div>

  <!-- Pets Table -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-600">
        <thead class="bg-slate-50 text-xs font-semibold text-slate-400 uppercase border-b border-slate-100">
          <tr>
            <th class="px-6 py-3.5"><%= t('.table.name') %></th>
            <th class="px-6 py-3.5"><%= t('.table.species_breed') %></th>
            <th class="px-6 py-3.5"><%= t('.table.age') %></th>
            <th class="px-6 py-3.5"><%= t('.table.status') %></th>
            <th class="px-6 py-3.5"><%= t('.table.active_switch', default: 'Activo') %></th>
            <th class="px-6 py-3.5 text-right"><%= t('admin.shared.actions') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if @pets.any? %>
            <% @pets.each do |pet| %>
              <tr class="hover:bg-slate-50/50 transition">
                <td class="px-6 py-4 font-semibold text-slate-900">
                  <%= link_to admin_pet_path(pet), class: "flex items-center gap-3 hover:text-emerald-600 transition group" do %>
                    <div class="w-9 h-9 rounded-xl bg-slate-100 flex items-center justify-center text-base group-hover:bg-emerald-50 transition">
                      <%= pet.breed&.species&.downcase == 'cat' ? '🐱' : '🐶' %>
                    </div>
                    <span><%= pet.name %></span>
                  <% end %>
                </td>
                
                <!-- Breed / Species -->
                <td class="px-6 py-4">
                  <span class="font-semibold text-slate-800 block"><%= pet.breed&.name || t('.table.no_breed') %></span>
                  <span class="text-slate-400 text-xs capitalize">
                    <%= pet.breed&.species.present? ? t("activerecord.attributes.breed/species.#{pet.breed.species.downcase}", default: pet.breed.species) : "N/A" %>
                  </span>
                </td>

                <!-- Age -->
                <td class="px-6 py-4 text-slate-600">
                  <%= pet.formatted_age %>
                </td>

                <!-- Adoption Status Badge -->
                <td class="px-6 py-4">
                  <% badge_class = case pet.status
                     when 'available' then 'bg-emerald-50 text-emerald-700 border-emerald-200'
                     when 'in_process' then 'bg-amber-50 text-amber-700 border-amber-200'
                     when 'adopted' then 'bg-slate-100 text-slate-600 border-slate-200'
                     else 'bg-slate-50 text-slate-600 border-slate-200'
                     end %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold border <%= badge_class %>">
                    <%= t("activerecord.attributes.pet/status.#{pet.status}", default: pet.status.humanize) %>
                  </span>
                </td>

                <!-- Interactive Active Toggle Switch -->
                <td class="px-6 py-4">
                  <% if pet.active? %>
                    <%= button_to admin_pet_path(pet, pet: { active: false }), 
                                  method: :patch, 
                                  title: t('admin.shared.click_to_deactivate', default: 'Clic para desactivar'),
                                  class: "group flex items-center gap-2 cursor-pointer focus:outline-none" do %>
                      <!-- Switch Track (ON) -->
                      <div class="w-9 h-5 bg-emerald-500 rounded-full transition-colors relative p-0.5 group-hover:bg-emerald-600 shadow-inner">
                        <!-- Switch Thumb -->
                        <div class="w-4 h-4 bg-white rounded-full shadow-md transform translate-x-4 transition-transform"></div>
                      </div>
                      <span class="text-xs font-semibold text-emerald-700 select-none">
                        <%= t('admin.shared.status_active', default: 'Activo') %>
                      </span>
                    <% end %>
                  <% else %>
                    <%= button_to admin_pet_path(pet, pet: { active: true }), 
                                  method: :patch, 
                                  title: t('admin.shared.click_to_activate', default: 'Clic para activar'),
                                  class: "group flex items-center gap-2 cursor-pointer focus:outline-none" do %>
                      <!-- Switch Track (OFF) -->
                      <div class="w-9 h-5 bg-slate-300 rounded-full transition-colors relative p-0.5 group-hover:bg-slate-400 shadow-inner">
                        <!-- Switch Thumb -->
                        <div class="w-4 h-4 bg-white rounded-full shadow-md transform translate-x-0 transition-transform"></div>
                      </div>
                      <span class="text-xs font-semibold text-slate-500 select-none">
                        <%= t('admin.shared.status_inactive', default: 'Inactivo') %>
                      </span>
                    <% end %>
                  <% end %>
                </td>

                <!-- Actions Column -->
                <td class="px-6 py-4 text-right space-x-2">
                  <%= link_to t('admin.shared.show'), admin_pet_path(pet), class: "text-xs font-semibold text-slate-600 hover:text-slate-900 transition" %>
                  <%= link_to t('admin.shared.edit'), edit_admin_pet_path(pet), class: "text-xs font-semibold text-emerald-600 hover:text-emerald-700 transition" %>
                  <%= button_to t('admin.shared.delete'), admin_pet_path(pet), method: :delete, data: { turbo_confirm: t('admin.pets.destroy.confirm_delete', name: pet.name) }, class: "inline-block text-xs font-semibold text-rose-600 hover:text-rose-700 transition cursor-pointer" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-6 py-8 text-center text-slate-400 text-sm">
                <%= t('.table.no_pets') %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <!--Paginate-->
      <%= render 'admin/shared/pagination', pagy: @pagy %>
    </div>
  </div>
</div>