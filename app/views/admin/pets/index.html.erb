<% content_for :page_title, "Mascotas" %>

<div class="space-y-6">
  <!-- Acciones y Filtros superior -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h3 class="text-xl font-bold text-slate-800">Listado de Mascotas</h3>
      <p class="text-xs text-slate-500 mt-0.5">Gestión de animales registrados en el refugio</p>
    </div>
    
    <%= link_to new_admin_pet_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-xl shadow-sm transition cursor-pointer self-start sm:self-auto" do %>
      <span>➕</span> Registrar Mascota
    <% end %>
  </div>

  <!-- Tabla de Mascotas -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-600">
        <thead class="bg-slate-50 text-xs font-semibold text-slate-400 uppercase border-b border-slate-100">
          <tr>
            <th class="px-6 py-3.5">Nombre</th>
            <th class="px-6 py-3.5">Especie / Raza</th>
            <th class="px-6 py-3.5">Edad</th>
            <th class="px-6 py-3.5">Estado</th>
            <th class="px-6 py-3.5 text-right">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if @pets.any? %>
            <% @pets.each do |pet| %>
              <tr class="hover:bg-slate-50/50 transition">
                <td class="px-6 py-4 font-semibold text-slate-900">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-slate-100 flex items-center justify-center text-base">
                      <%= pet.species == 'cat' ? '🐱' : '🐶' %>
                    </div>
                    <span><%= pet.name %></span>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <span class="capitalize text-slate-800 font-medium"><%= pet.species %></span>
                  <span class="text-slate-400 text-xs block"><%= pet.breed.presence || "Sin raza especificada" %></span>
                </td>
                <td class="px-6 py-4 text-slate-600">
                  <%= pet.age %> <%= pet.age == 1 ? 'año' : 'años' %>
                </td>
                <td class="px-6 py-4">
                  <% badge_class = case pet.status
                     when 'available' then 'bg-emerald-50 text-emerald-700 border-emerald-200'
                     when 'pending' then 'bg-amber-50 text-amber-700 border-amber-200'
                     when 'adopted' then 'bg-slate-100 text-slate-600 border-slate-200'
                     else 'bg-slate-50 text-slate-600 border-slate-200'
                     end %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold border <%= badge_class %> capitalize">
                    <%= pet.status %>
                  </span>
                </td>
                <td class="px-6 py-4 text-right space-x-2">
                  <%= link_to "Editar", edit_admin_pet_path(pet), class: "text-xs font-semibold text-emerald-600 hover:text-emerald-700 transition" %>
                  <%= button_to "Eliminar", admin_pet_path(pet), method: :delete, data: { turbo_confirm: "¿Confirmás eliminar a #{pet.name}?" }, class: "inline-block text-xs font-semibold text-rose-600 hover:text-rose-700 transition cursor-pointer" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="px-6 py-8 text-center text-slate-400 text-sm">
                No hay mascotas registradas todavía.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>