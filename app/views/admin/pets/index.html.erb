<div class="flex justify-between items-center mb-6">
  <h2 class="text-2xl font-bold text-gray-800">Mascotas</h2>
  <%= link_to "Nueva Mascota", new_admin_pet_path, class: "bg-indigo-600 text-white px-4 py-2 rounded shadow hover:bg-indigo-700" %>
</div>

<div class="bg-white rounded shadow overflow-hidden">
  <table class="w-full text-left border-collapse">
    <thead class="bg-gray-50 border-b">
      <tr>
        <th class="p-3 text-sm font-semibold text-gray-600">Nombre</th>
        <th class="p-3 text-sm font-semibold text-gray-600">Raza</th>
        <th class="p-3 text-sm font-semibold text-gray-600">Estado</th>
        <th class="p-3 text-sm font-semibold text-gray-600">Edad</th>
        <th class="p-3 text-sm font-semibold text-gray-600">Acciones</th>
      </tr>
    </thead>
    <tbody class="divide-y">
      <% @pets.each do |pet| %>
        <tr class="hover:bg-gray-50">
          <td class="p-3 font-medium"><%= pet.name %></td>
          <td class="p-3"><%= pet.breed.name %></td>
          <td class="p-3">
            <span class="px-2 py-1 text-xs font-semibold rounded bg-blue-100 text-blue-800"><%= pet.status %></span>
          </td>
          <td class="p-3"><%= pet.age_months %> meses</td>
          <td class="p-3 space-x-2">
            <%= link_to "Ver", admin_pet_path(pet), class: "text-blue-600 hover:underline text-sm" %>
            <%= link_to "Editar", edit_admin_pet_path(pet), class: "text-amber-600 hover:underline text-sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>