<% content_for :page_title, t('.title') %>

<div class="max-w-4xl mx-auto space-y-6">
  <!-- Top header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <% back_link = pet_back_link_attributes %>
      <%= link_to back_link[:label], back_link[:path], class: "text-xs text-emerald-600 hover:text-emerald-700 font-semibold mb-1 inline-block" %>
      <h3 class="text-2xl font-bold text-slate-800 flex items-center gap-3">
        <%= @pet.name %>
        <% badge_class = case @pet.status
           when 'available' then 'bg-emerald-50 text-emerald-700 border-emerald-200'
           when 'in_process' then 'bg-amber-50 text-amber-700 border-amber-200'
           when 'adopted' then 'bg-slate-100 text-slate-600 border-slate-200'
           else 'bg-slate-50 text-slate-600 border-slate-200'
           end %>
        <span class="text-xs px-3 py-1 rounded-full font-semibold border <%= badge_class %>">
          <%= t("activerecord.attributes.pet/status.#{@pet.status}", default: @pet.status.humanize) %>
        </span>
      </h3>
    </div>

    <!-- Actions Bar with Interactive Active Toggle Switch -->
    <div class="flex items-center gap-4">
      <% if @pet.active? %>
        <%= button_to admin_pet_path(@pet, pet: { active: false }), 
                      method: :patch, 
                      title: t('admin.shared.click_to_deactivate', default: 'Clic para desactivar'),
                      class: "group flex items-center gap-2 cursor-pointer focus:outline-none bg-white px-3 py-1.5 rounded-xl border border-slate-200/80 shadow-xs hover:border-slate-300 transition" do %>
          <!-- Switch Track (ON) -->
          <div class="w-9 h-5 bg-emerald-500 rounded-full transition-colors relative p-0.5 group-hover:bg-emerald-600 shadow-inner">
            <!-- Switch Thumb -->
            <div class="w-4 h-4 bg-white rounded-full shadow-md transform translate-x-4 transition-transform"></div>
          </div>
          <span class="text-xs font-semibold text-emerald-700 select-none">
            <%= t('admin.shared.status_active', default: 'Activo') %>
          </span>
        <% end %>
      <% else %>
        <%= button_to admin_pet_path(@pet, pet: { active: true }), 
                      method: :patch, 
                      title: t('admin.shared.click_to_activate', default: 'Clic para activar'),
                      class: "group flex items-center gap-2 cursor-pointer focus:outline-none bg-white px-3 py-1.5 rounded-xl border border-slate-200/80 shadow-xs hover:border-slate-300 transition" do %>
          <!-- Switch Track (OFF) -->
          <div class="w-9 h-5 bg-slate-300 rounded-full transition-colors relative p-0.5 group-hover:bg-slate-400 shadow-inner">
            <!-- Switch Thumb -->
            <div class="w-4 h-4 bg-white rounded-full shadow-md transform translate-x-0 transition-transform"></div>
          </div>
          <span class="text-xs font-semibold text-slate-500 select-none">
            <%= t('admin.shared.status_inactive', default: 'Inactivo') %>
          </span>
        <% end %>
      <% end %>

      <%= link_to t('admin.pets.index.table.edit'), edit_admin_pet_path(@pet), class: "px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-xl shadow-sm transition" %>
    </div>
  </div>

  <!-- Active Storage Photos Gallery -->
  <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
    <h4 class="text-sm font-bold text-slate-800"><%= t('.photos') %></h4>
    <% if @pet.photos.attached? %>
      <!-- Grid with explicit card sizing -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        <% @pet.photos.each do |photo| %>
          <div class="h-40 rounded-xl overflow-hidden bg-slate-100 border border-slate-200/60 shadow-xs">
            <%= image_tag photo, class: "w-full h-full object-cover hover:scale-105 transition duration-300" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-8 text-center bg-slate-50 rounded-xl border border-dashed border-slate-200 text-slate-400 text-xs">
        📷 <%= t('.no_photos') %>
      </div>
    <% end %>
  </div>

  <!-- General Info -->
  <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
    <h4 class="text-sm font-bold text-slate-800"><%= t('.general_info') %></h4>
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
      <div>
        <dt class="text-slate-400 font-medium mb-0.5"><%= t('activerecord.attributes.breed.species') %></dt>
        <dd class="text-slate-800 font-semibold capitalize">
          <%= @pet.breed&.species.present? ? t("activerecord.attributes.breed/species.#{@pet.breed.species.downcase}", default: @pet.breed.species) : "N/A" %>
        </dd>
      </div>

      <div>
        <dt class="text-slate-400 font-medium mb-0.5"><%= t('activerecord.attributes.pet.breed') %></dt>
        <dd class="text-slate-800 font-semibold"><%= @pet.breed&.name || "N/A" %></dd>
      </div>

      <div>
        <dt class="text-slate-400 font-medium mb-0.5"><%= t('admin.pets.index.table.age') %></dt>
        <dd class="text-slate-800 font-semibold"><%= @pet.formatted_age %></dd>
      </div>

      <div>
        <dt class="text-slate-400 font-medium mb-0.5"><%= t('activerecord.attributes.pet.shelter') %></dt>
        <dd class="text-slate-800 font-semibold"><%= @pet.shelter&.name || "N/A" %></dd>
      </div>

      <div class="sm:col-span-2">
        <dt class="text-slate-400 font-medium mb-0.5"><%= t('activerecord.attributes.pet.description') %></dt>
        <dd class="text-slate-700 leading-relaxed bg-slate-50 p-3.5 rounded-xl border border-slate-100 mt-1">
          <%= @pet.description.presence || "Sin descripción proporcionada." %>
        </dd>
      </div>
    </dl>
  </div>

  <!-- Medical Records Section -->
  <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <h4 class="text-sm font-bold text-slate-800">🏥 <%= t('admin.medical_records.index.title') %></h4>
      <%= link_to new_admin_pet_medical_record_path(@pet), data: { turbo_frame: "_top" }, class: "inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-xl shadow-sm transition" do %>
        <span>➕</span> <%= t('admin.medical_records.new.add_record') %>
      <% end %>
    </div>

    <%= turbo_frame_tag "pet_medical_records" do %>
      <% if @medical_records.any? %>
        <div class="space-y-3">
          <% @medical_records.each do |record| %>
            <div class="p-4 rounded-xl border border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-slate-50 transition">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800">
                    <%= t("activerecord.attributes.medical_record/record_type.#{record.record_type}", default: record.record_type.humanize) %>
                  </span>
                  <span class="text-xs text-slate-400"><%= l(record.performed_at, format: :short) rescue record.performed_at %></span>
                </div>
                <p class="text-sm font-bold text-slate-800"><%= record.title %></p>
                <% if record.notes.present? %>
                  <p class="text-xs text-slate-600 mt-1"><%= record.notes %></p>
                <% end %>
              </div>

              <!-- Actions -->
              <div class="flex items-center gap-2 self-end sm:self-center">
                <%= link_to t('admin.shared.edit'), edit_admin_medical_record_path(record), data: { turbo_frame: "_top" }, class: "text-xs font-semibold text-emerald-600 hover:text-emerald-700 transition" %>
                <%= button_to t('admin.shared.delete'), admin_medical_record_path(record), method: :delete, data: { turbo_confirm: t('admin.medical_records.destroy.confirm'), turbo_frame: "_top" }, class: "text-xs font-semibold text-rose-600 hover:text-rose-700 transition cursor-pointer" %>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Paginate -->
        <div class="mt-4">
          <%= render 'admin/shared/pagination', pagy: @pagy_medical_records %>
        </div>
      <% else %>
        <div class="p-8 text-center bg-slate-50 rounded-xl border border-dashed border-slate-200 text-slate-400 text-xs">
          🩺 <%= t('admin.medical_records.index.no_records') %>
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- Adoption application section -->
  <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
    <div class="border-b border-slate-100 pb-3">
      <h4 class="text-sm font-bold text-slate-800">📄 <%= t('admin.adoption_applications.index.title') %></h4>
    </div>
    <%= turbo_frame_tag "adoption_applications" do %>
      <% if @adoption_applications.any? %>
        <div class="space-y-3">
          <% @adoption_applications.each do |application| %>
            <div class="p-4 rounded-xl border border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-slate-50 transition">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800">
                    <%= t("activerecord.attributes.adoption_application/status.#{application.status}", default: application.status.humanize) %>
                  </span>
                  <span class="text-xs text-slate-400"><%= l(application.created_at, format: :short) rescue application.created_at %></span>
                </div>
                <p class="text-sm font-bold text-slate-800"><%= application.user&.full_name || "N/A" %></p>
                <% if application.notes.present? %>
                  <p class="text-xs text-slate-600 mt-1"><%= application.notes %></p>
                <% end %>
              </div>

              <!-- Actions -->
              <div class="flex items-center gap-2 self-end sm:self-center">
                <%= link_to t('admin.adoption_applications.index.table.review'), 
                    admin_adoption_application_path(application, return_to: admin_pet_path(@pet)), 
                    data: { turbo_frame: "_top" }, 
                    class: "text-indigo-600 hover:underline font-medium text-sm" %>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Paginate -->
        <div class="mt-4">
          <%= render 'admin/shared/pagination', pagy: @pagy_adoption_applications %>
        </div>
      <% else %>
        <div class="p-8 text-center bg-slate-50 rounded-xl border border-dashed border-slate-200 text-slate-400 text-xs">
          📄 <%= t('admin.adoption_applications.index.no_applications') %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>