<% form_model = medical_record.persisted? ? [:admin, medical_record] : [:admin, pet, medical_record] %>

<%= form_with(model: form_model, local: true, class: "space-y-6 bg-white p-6 md:p-8 rounded-2xl border border-slate-200/80 shadow-sm") do |f| %>
  <% if medical_record.errors.any? %>
    <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-medium space-y-1">
      <p class="font-bold text-sm"><%= t('.error_header') %></p>
      <ul class="list-disc list-inside space-y-0.5">
        <% medical_record.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Record Type -->
    <div>
      <%= f.label :record_type, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
      <%= f.select :record_type, MedicalRecord.record_types.keys.map { |type| [t("activerecord.attributes.medical_record/record_type.#{type}", default: type.humanize), type] }, { prompt: t('helpers.select.prompt', default: 'Seleccionar...') }, class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2.5 px-3.5 text-slate-800 bg-white outline-none transition" %>
    </div>

    <!-- Title -->
    <div>
      <%= f.label :title, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
      <%= f.text_field :title, placeholder: "Ej: Vacuna Rabia / Desparasitación Interna", class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2.5 px-3.5 text-slate-800 outline-none transition" %>
    </div>

    <!-- Performed At Date -->
    <div>
      <%= f.label :performed_at, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
      <%= f.date_field :performed_at, class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2.5 px-3.5 text-slate-800 outline-none transition" %>
    </div>

    <!-- Next Due Date -->
    <div>
      <%= f.label :next_due_date, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
      <%= f.date_field :next_due_date, class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2.5 px-3.5 text-slate-800 outline-none transition" %>
    </div>

    <!-- Notes -->
    <div class="md:col-span-2">
      <%= f.label :notes, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
      <%= f.text_area :notes, rows: 4, placeholder: "Observaciones, dosis o notas clínicas...", class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2.5 px-3.5 text-slate-800 outline-none transition" %>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
    <%= link_to t('admin.shared.cancel'), admin_pet_path(pet), class: "px-4 py-2.5 rounded-xl border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50 transition" %>
    <%= f.submit class: "px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-sm transition cursor-pointer" %>
  </div>
<% end %>