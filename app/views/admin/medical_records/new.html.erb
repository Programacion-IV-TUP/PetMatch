<% content_for :page_title, t('.title') %>

<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h3 class="text-xl font-bold text-slate-800">
        <%= t('.header', name: @pet.name) %>
      </h3>
      <%= link_to t('.back', pet: @pet.name), admin_pet_path(@pet), class: "text-xs text-emerald-600 hover:text-emerald-700 font-semibold mt-1 inline-block" %>
    </div>
  </div>

  <%= render "form", pet: @pet, medical_record: @medical_record %>
</div>