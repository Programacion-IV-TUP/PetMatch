<% if pagy.pages > 1 %>
  <div class="flex items-center justify-between px-6 py-4 bg-white border-t border-slate-100 rounded-b-2xl">
    <div class="text-xs text-slate-500">
      <%= t('admin.shared.pagination.showing', 
            from: pagy.from, 
            to: pagy.to, 
            count: pagy.count) %>
    </div>

    <div class="flex items-center gap-2">
      <!-- Previous button -->
      <% if pagy.prev %>
        <%= link_to pagy_url_for(pagy, pagy.prev), class: "px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50 transition" do %>
          &larr; <%= t('admin.shared.pagination.previous') %>
        <% end %>
      <% else %>
        <span class="px-3 py-1.5 rounded-lg border border-slate-100 text-xs font-semibold text-slate-300 cursor-not-allowed">
          &larr; <%= t('admin.shared.pagination.previous') %>
        </span>
      <% end %>

      <!-- Page indicator -->
      <span class="text-xs font-semibold text-slate-600 px-2">
        <%= t('admin.shared.pagination.page_info', page: pagy.page, pages: pagy.pages) %>
      </span>

      <!-- Next button -->
      <% if pagy.next %>
        <%= link_to pagy_url_for(pagy, pagy.next), class: "px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50 transition" do %>
          <%= t('admin.shared.pagination.next') %> &rarr;
        <% end %>
      <% else %>
        <span class="px-3 py-1.5 rounded-lg border border-slate-100 text-xs font-semibold text-slate-300 cursor-not-allowed">
          <%= t('admin.shared.pagination.next') %> &rarr;
        </span>
      <% end %>
    </div>
  </div>
<% end %>