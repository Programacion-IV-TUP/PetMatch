<h2 class="text-2xl font-bold text-gray-800 mb-6">Solicitudes de Adopción</h2>

<div class="bg-white rounded shadow overflow-hidden">
  <table class="w-full text-left border-collapse">
    <thead class="bg-gray-50 border-b">
      <tr>
        <th class="p-3 text-sm font-semibold text-gray-600">Mascota</th>
        <th class="p-3 text-sm font-semibold text-gray-600">Solicitante</th>
        <th class="p-3 text-sm font-semibold text-gray-600">Estado</th>
        <th class="p-3 text-sm font-semibold text-gray-600">Acciones</th>
      </tr>
    </thead>
    <tbody class="divide-y">
      <% @adoption_applications.each do |application| %>
        <tr class="hover:bg-gray-50">
          <td class="p-3 font-medium"><%= application.pet.name %></td>
          <td class="p-3"><%= application.user.email_address %></td>
          <td class="p-3">
            <span class="px-2 py-1 text-xs font-semibold rounded bg-yellow-100 text-yellow-800">
              <%= AdoptionApplication.human_attribute_name("status.#{application.status}") %>
            </span>
          </td>
          <td class="p-3">
            <%= link_to "Revisar", admin_adoption_application_path(application), class: "text-indigo-600 hover:underline font-medium text-sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>