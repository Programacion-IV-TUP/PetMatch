<% content_for :page_title, t('.title') %>

<div class="space-y-6">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <h3 class="text-xl md:text-2xl font-bold text-slate-800"><%= t('.title') %></h3>
    </div>
  </div>

  <!-- Hotwire Turbo Frame for list updates -->
  <%= turbo_frame_tag "applications_list" do %>
    <% if @adoption_applications.any? %>
      <!-- MOBILE VIEW: Compact cards (visible on < md screens) -->
      <div class="grid grid-cols-1 gap-4 md:hidden">
        <% @adoption_applications.each do |application| %>
          <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm space-y-3">
            <!-- Card Header: Pet and Status -->
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-lg flex-shrink-0">
                  <%= application.pet&.breed&.species&.downcase == 'cat' ? '🐱' : '🐶' %>
                </div>
                <div>
                  <h4 class="font-bold text-slate-900 text-sm"><%= application.pet.name %></h4>
                  <p class="text-xs text-slate-500"><%= application.user.full_name %></p>
                </div>
              </div>

              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50 text-amber-700 border border-amber-200 flex-shrink-0">
                <%= AdoptionApplication.human_attribute_name("status.#{application.status}") %>
              </span>
            </div>

            <!-- Card Actions -->
            <div class="flex items-center justify-end pt-3 border-t border-slate-100 text-xs">
              <%= link_to admin_adoption_application_path(application), data: { turbo_frame: "_top" }, class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-50 text-indigo-600 hover:bg-indigo-100 font-semibold transition" do %>
                👁️ <%= t('.table.review') %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- DESKTOP VIEW: Full table (visible on >= md screens) -->
      <div class="hidden md:block bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm text-slate-600">
            <thead class="bg-slate-50 text-xs font-semibold text-slate-400 uppercase border-b border-slate-100">
              <tr>
                <th class="px-6 py-3.5"><%= t('.table.pet') %></th>
                <th class="px-6 py-3.5"><%= t('.table.applicant') %></th>
                <th class="px-6 py-3.5"><%= t('.table.status') %></th>
                <th class="px-6 py-3.5 text-right"><%= t('.table.actions') %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @adoption_applications.each do |application| %>
                <tr class="hover:bg-slate-50/50 transition">
                  <td class="px-6 py-4 font-bold text-slate-800"><%= application.pet.name %></td>
                  <td class="px-6 py-4 text-slate-600"><%= application.user.full_name %></td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                      <%= AdoptionApplication.human_attribute_name("status.#{application.status}") %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <%= link_to t('.table.review'), admin_adoption_application_path(application), data: { turbo_frame: "_top" }, class: "text-indigo-600 hover:underline font-semibold text-xs" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Pagination -->
      <div class="bg-white border-t border-slate-100 p-4 rounded-b-2xl">
        <%= render 'admin/shared/pagination', pagy: @pagy %>
      </div>
    <% else %>
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-8 text-center text-slate-400 text-sm">
        <%= t('.empty', default: 'No applications found.') %>
      </div>
    <% end %>
  <% end %>
</div>