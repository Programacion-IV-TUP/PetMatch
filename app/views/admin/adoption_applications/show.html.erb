<%# app/views/admin/adoption_applications/show.html.erb %>
<% content_for :page_title, t('admin.adoption_applications.show.title') %>

<div class="max-w-4xl mx-auto space-y-6">
  <!-- Navigation and header -->
  <div class="flex items-center justify-between">
    <div>
      <%= link_to t('admin.shared.back'), admin_adoption_applications_path, class: "text-xs text-emerald-600 hover:text-emerald-700 font-semibold mb-1 inline-block" %>
      <h3 class="text-2xl font-bold text-slate-800">
        <%= t('admin.adoption_applications.show.title') %> #<%= @application.id %>
      </h3>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Main content: Applicant and Pet details -->
    <div class="md:col-span-2 space-y-6">
      <!-- Applicant information -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
        <h4 class="text-sm font-bold text-slate-800 border-b border-slate-100 pb-3">
          <%= t('admin.adoption_applications.show.applicant_info') %>
        </h4>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <div>
            <dt class="text-slate-400 font-medium mb-0.5"><%= t('activerecord.attributes.adoption_application.user') %></dt>
            <dd class="text-slate-800 font-semibold"><%= @application.user&.full_name %></dd>
          </div>
          <div>
            <dt class="text-slate-400 font-medium mb-0.5">Email</dt>
            <dd class="text-slate-800 font-semibold"><%= @application.user&.email_address %></dd>
          </div>
        </dl>
      </div>

      <!-- Requested pet information -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
        <h4 class="text-sm font-bold text-slate-800 border-b border-slate-100 pb-3">
          <%= t('admin.adoption_applications.show.pet_info') %>
        </h4>
        <div class="flex items-center gap-4 text-xs">
          <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-xl">
            <%= @application.pet&.breed&.species&.downcase == 'cat' ? '🐱' : '🐶' %>
          </div>
          <div>
            <p class="text-sm font-bold text-slate-900"><%= @application.pet&.name %></p>
            <span class="text-slate-500"><%= @application.pet&.breed&.name %></span>
          </div>
          <%= link_to t('admin.shared.show'), admin_pet_path(@application.pet, from_application_id: @application.id), class: "ml-auto text-xs font-semibold text-emerald-600 hover:text-emerald-700" %>
        </div>
      </div>
    </div>

    <!-- Sidebar: Status management form -->
    <div class="space-y-6">
      <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
        <h4 class="text-sm font-bold text-slate-800 border-b border-slate-100 pb-3">
          <%= t('admin.adoption_applications.show.update_status') %>
        </h4>

        <%= form_with(model: [:admin, @application], local: true, class: "space-y-4") do |f| %>
          <div>
            <%= f.label :status, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
            <%= f.select :status, AdoptionApplication.statuses.keys.map { |s| [t("activerecord.attributes.adoption_application/status.#{s}"), s] }, {}, class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-xs py-2.5 px-3 text-slate-800 bg-white outline-none transition" %>
          </div>

          <div>
            <%= f.label :notes, t('admin.adoption_applications.show.internal_notes'), class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
            <%= f.text_area :notes, rows: 4, class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-xs py-2.5 px-3 text-slate-800 outline-none transition" %>
          </div>

          <%= f.submit t('admin.shared.save_changes'), class: "w-full py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-sm transition cursor-pointer" %>
        <% end %>
      </div>
    </div>
  </div>
</div>