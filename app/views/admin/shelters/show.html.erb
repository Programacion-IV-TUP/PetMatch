<% content_for :page_title, @shelter.name %>

<div class="max-w-5xl mx-auto space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <%= link_to t('admin.shared.back'), admin_shelters_path, class: "text-xs text-emerald-600 hover:text-emerald-700 font-semibold mb-1 inline-block" %>
      <h3 class="text-2xl font-bold text-slate-800 flex items-center gap-3">
        <%= @shelter.name %>
        <% unless @shelter.active? %>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold border bg-slate-100 text-slate-600 border-slate-200">
            <%= t('admin.shared.status_inactive') %>
          </span>
        <% end %>
      </h3>
    </div>

    <!-- Actions & Active Toggle -->
    <div class="flex items-center gap-3">
      <% if current_user.admin? %>
        <% if @shelter.active? %>
          <%= button_to admin_shelter_path(@shelter, shelter: { active: false }), 
                        method: :patch, 
                        title: t('admin.shared.click_to_deactivate'),
                        class: "group flex items-center gap-2 cursor-pointer focus:outline-none bg-white px-3 py-1.5 rounded-xl border border-slate-200/80 shadow-xs hover:border-slate-300 transition" do %>
            <div class="w-9 h-5 bg-emerald-500 rounded-full transition-colors relative p-0.5 group-hover:bg-emerald-600 shadow-inner">
              <div class="w-4 h-4 bg-white rounded-full shadow-md transform translate-x-4 transition-transform"></div>
            </div>
            <span class="text-xs font-semibold text-emerald-700 select-none">
              <%= t('admin.shared.status_active') %>
            </span>
          <% end %>
        <% else %>
          <%= button_to admin_shelter_path(@shelter, shelter: { active: true }), 
                        method: :patch, 
                        title: t('admin.shared.click_to_activate'),
                        class: "group flex items-center gap-2 cursor-pointer focus:outline-none bg-white px-3 py-1.5 rounded-xl border border-slate-200/80 shadow-xs hover:border-slate-300 transition" do %>
            <div class="w-9 h-5 bg-slate-300 rounded-full transition-colors relative p-0.5 group-hover:bg-slate-400 shadow-inner">
              <div class="w-4 h-4 bg-white rounded-full shadow-md transform translate-x-0 transition-transform"></div>
            </div>
            <span class="text-xs font-semibold text-slate-500 select-none">
              <%= t('admin.shared.status_inactive') %>
            </span>
          <% end %>
        <% end %>
      <% end %>

      <%= link_to edit_admin_shelter_path(@shelter), class: "px-4 py-2 rounded-xl border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition" do %>
        <%= t('admin.shared.edit') %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Info Sidebar -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
      <!-- Shelter Logo Header -->
      <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
        <div class="w-16 h-16 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-center overflow-hidden p-1 flex-shrink-0">
          <% if @shelter.logo.attached? %>
            <%= optimized_image_tag @shelter.logo,
                        variant_options: { resize_to_limit: [300, 300] },
                        class: "w-20 h-20 rounded-full object-cover border border-slate-200 shadow-sm",
                        alt: @shelter.name %>
          <% else %>
            <span class="text-2xl">🏠</span>
          <% end %>
        </div>
      <h4 class="text-sm font-bold text-slate-800 border-b border-slate-100 pb-3"><%= t('.details') %></h4>
      <dl class="space-y-3 text-xs">
        <div>
          <dt class="text-slate-400 font-medium"><%= t('activerecord.attributes.shelter.city') %></dt>
          <dd class="text-slate-800 font-semibold mt-0.5"><%= @shelter.address&.city&.name || "-" %></dd>
        </div>
        <div>
          <dt class="text-slate-400 font-medium"><%= t('activerecord.attributes.shelter.address') %></dt>
          <dd class="text-slate-800 font-semibold mt-0.5"><%= @shelter.address&.full_address || "-" %></dd>
        </div>
        <div>
          <dt class="text-slate-400 font-medium"><%= t('activerecord.attributes.shelter.phone') %></dt>
          <dd class="text-slate-800 font-semibold mt-0.5"><%= @shelter.phone.presence || "-" %></dd>
        </div>
      </dl>
    </div>

    <!-- Associated Pets -->
    <div class="md:col-span-2 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <h4 class="text-sm font-bold text-slate-800">🐾 <%= t('.pets') %></h4>
        <span class="text-xs font-semibold text-slate-500"><%= @shelter.pets.count rescue 0 %> registradas</span>
      </div>

      <% if @shelter.pets.respond_to?(:any?) && @shelter.pets.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <% @shelter.pets.each do |pet| %>
            <div class="p-3 rounded-xl border border-slate-100 bg-slate-50/50 flex items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-slate-200 overflow-hidden flex-shrink-0">
                  <% if pet.photos.attached? %>
                    <%= optimized_image_tag pet.photos.first,
                        variant_options: { resize_to_fill: [100, 100, { crop: :fill, gravity: :auto }] },
                        class: "w-20 h-20 rounded-full object-cover border border-slate-200 shadow-sm",
                        alt: pet.name %>
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center text-sm">
                      <%= pet.breed&.species&.downcase == 'cat' ? '🐱' : '🐶' %>
                    </div>
                  <% end %>
                </div>
                <div>
                  <p class="text-xs font-bold text-slate-800"><%= pet.name %></p>
                  <p class="text-[11px] text-slate-500"><%= pet.breed&.name %></p>
                </div>
              </div>
              <%= link_to admin_pet_path(pet, from_shelter_id: @shelter.id), class: "text-xs font-semibold text-emerald-600 hover:text-emerald-700" do %>
                <%= t('admin.shared.show') %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="p-8 text-center bg-slate-50 rounded-xl border border-dashed border-slate-200 text-slate-400 text-xs">
          <%= t('.no_pets') %>
        </div>
      <% end %>
    </div>
  </div>
</div>