<%= form_with(model: [:admin, shelter], local: true, class: "space-y-6 bg-white p-6 md:p-8 rounded-2xl border border-slate-200/80 shadow-sm") do |f| %>
  <% if shelter.errors.any? %>
    <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-medium space-y-1">
      <p class="font-bold text-sm"><%= t('admin.shared.form_error_header', default: 'Por favor corregí los siguientes errores:') %></p>
      <ul class="list-disc list-inside space-y-0.5">
        <% shelter.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Name -->
    <div class="md:col-span-2">
      <%= f.label :name, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
      <%= f.text_field :name, placeholder: "Ej: Refugio San Francisco", class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2.5 px-3.5 text-slate-800 outline-none transition" %>
    </div>

    <!-- City -->
    <div>
      <%= f.label :city_id, t('activerecord.attributes.shelter.city', default: 'Ciudad'), class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
      <%= f.collection_select :city_id, City.order(:name), :id, :name, { prompt: t('helpers.select.prompt', default: 'Seleccionar...') }, class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2.5 px-3.5 text-slate-800 bg-white outline-none transition" %>
    </div>

    <!-- Phone -->
    <div>
      <%= f.label :phone, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
      <%= f.text_field :phone, placeholder: "Ej: +54 221 1234567", class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2.5 px-3.5 text-slate-800 outline-none transition" %>
    </div>

    <!-- Address -->
    <div class="md:col-span-2">
      <%= f.label :address, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
      <%= f.text_field :address, placeholder: "Ej: Calle 12 #456", class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2.5 px-3.5 text-slate-800 outline-none transition" %>
    </div>

    <!-- Email / Contact Email (if applicable) -->
    <div class="md:col-span-2">
      <%= f.label :description, t('activerecord.attributes.shelter.description', default: 'Descripción / Información de contacto'), class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
      <%= f.text_area :description, rows: 4, placeholder: "Horarios de atención, historia o requisitos especiales...", class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2.5 px-3.5 text-slate-800 outline-none transition" %>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
    <%= link_to t('admin.shared.cancel', default: 'Cancelar'), admin_shelters_path, class: "px-4 py-2.5 rounded-xl border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50 transition" %>
    <%= f.submit class: "px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-sm transition cursor-pointer" %>
  </div>
<% end %>