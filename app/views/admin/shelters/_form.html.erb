<%= form_with(model: [:admin, shelter], local: true, class: "space-y-6 bg-white p-6 md:p-8 rounded-2xl border border-slate-200/80 shadow-sm") do |f| %>
  <% if shelter.errors.any? %>
    <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-medium space-y-1">
      <p class="font-bold text-sm"><%= t('admin.shared.form_error_header') %></p>
      <ul class="list-disc list-inside space-y-0.5">
        <% shelter.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Logo -->
    <div class="md:col-span-2">
      <%= f.label :logo, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
      <div class="flex items-center gap-4">
        <% if shelter.logo.attached? %>
          <%= image_tag shelter.logo, class: "w-16 h-16 rounded-xl object-cover border border-slate-200" %>
        <% end %>
        <%= f.file_field :logo, accept: "image/*", class: "block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 transition cursor-pointer" %>
      </div>
    </div>

    <!-- Name -->
    <div>
      <%= f.label :name, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
      <%= f.text_field :name, class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2.5 px-3.5 text-slate-800 outline-none transition" %>
    </div>

    <!-- Phone -->
    <div>
      <%= f.label :phone, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
      <%= f.text_field :phone, class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2.5 px-3.5 text-slate-800 outline-none transition" %>
    </div>

    <!-- Website -->
    <div>
      <%= f.label :website, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
      <%= f.url_field :website, class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2.5 px-3.5 text-slate-800 outline-none transition" %>
    </div>

    <!-- NESTED ADDRESS FIELDS -->
    <div class="md:col-span-2 border-t border-slate-100 pt-4 mt-2">
      <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-4"><%= t('.address_section') %></h4>
      
      <%= f.fields_for :address do |af| %>
        <div class="grid grid-cols-1 sm:grid-cols-3 md:grid-cols-4 gap-4">
          <!-- Street -->
          <div class="sm:col-span-2">
            <%= af.label :street, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
            <%= af.text_field :street, class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2 px-3 text-slate-800 outline-none transition" %>
          </div>

          <!-- Number -->
          <div>
            <%= af.label :number, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
            <%= af.text_field :number, class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2 px-3 text-slate-800 outline-none transition" %>
          </div>

          <!-- Floor -->
          <div>
            <%= af.label :floor, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
            <%= af.text_field :floor, class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2 px-3 text-slate-800 outline-none transition" %>
          </div>

          <!-- Apartment -->
          <div>
            <%= af.label :apartment, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
            <%= af.text_field :apartment, class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2 px-3 text-slate-800 outline-none transition" %>
          </div>

          <!-- Zip Code -->
          <div>
            <%= af.label :zip_code, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
            <%= af.text_field :zip_code, class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2 px-3 text-slate-800 outline-none transition" %>
          </div>

          <!-- City -->
          <div>
            <%= af.label :city_id, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
            <%= af.collection_select :city_id, City.order(:name), :id, :name, { prompt: t('helpers.select.prompt') }, class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2 px-3 text-slate-800 bg-white outline-none transition" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Description -->
    <div class="md:col-span-2 border-t border-slate-100 pt-4">
      <%= f.label :description, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
      <%= f.text_area :description, rows: 3, class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2.5 px-3.5 text-slate-800 outline-none transition" %>
    </div>

    <!-- Photos -->
    <div class="md:col-span-2">
      <%= f.label :photos, class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
      <%= f.file_field :photos, multiple: true, accept: "image/*", class: "block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 transition cursor-pointer" %>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
    <%= link_to t('admin.shared.cancel'), admin_shelters_path, class: "px-4 py-2.5 rounded-xl border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50 transition" %>
    <%= f.submit class: "px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-sm transition cursor-pointer" %>
  </div>
<% end %>