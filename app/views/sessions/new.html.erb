<% content_for :title, "Iniciar Sesión - PetMatch" %>

<div class="min-h-screen bg-slate-50 flex flex-col justify-center items-center px-4 py-12 sm:px-6 lg:px-8 font-sans text-slate-700 overflow-y-auto">
  
  <div class="w-full max-w-md text-center">
    <!-- Visual identity-->
    <div class="mx-auto w-12 h-12 rounded-2xl bg-emerald-600 flex items-center justify-center text-white text-2xl shadow-sm mb-3">
      🐾
    </div>
    <h2 class="text-2xl font-bold text-slate-900 tracking-tight">
      PetMatch Admin
    </h2>
    <p class="mt-1 text-sm text-slate-500">
      Ingresá tus credenciales para acceder al panel
    </p>
  </div>

  <div class="mt-8 w-full max-w-md">
    <div class="bg-white py-8 px-6 shadow-sm border border-slate-200/80 rounded-2xl sm:px-10">
      
      <!-- Alert / error message -->
      <% if flash[:alert] %>
        <div class="mb-5 p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-medium flex items-center gap-2">
          <span>⚠️</span>
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_with url: session_path, class: "space-y-5" do |f| %>
        
        <!-- Email -->
        <div>
          <%= f.label :email_address, "Correo electrónico", class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
          <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username", 
              placeholder: "admin@petmatch.com", 
              class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2.5 px-3.5 text-slate-800 placeholder-slate-400 outline-none transition" %>
        </div>

        <!-- Password -->
        <div>
          <%= f.label :password, "Contraseña", class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
          <%= f.password_field :password, required: true, autocomplete: "current-password", 
              placeholder: "••••••••", 
              class: "w-full rounded-xl border border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-sm py-2.5 px-3.5 text-slate-800 placeholder-slate-400 outline-none transition" %>
        </div>

        <!-- Submit Button -->
        <div>
          <%= f.submit "Iniciar sesión", 
              class: "w-full flex justify-center py-2.5 px-4 rounded-xl shadow-sm text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition cursor-pointer" %>
        </div>

      <% end %>

    </div>
  </div>

</div>