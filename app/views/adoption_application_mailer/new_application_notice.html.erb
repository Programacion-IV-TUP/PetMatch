<div style="font-family: sans-serif; color: #334155; max-width: 600px; margin: 0 auto; padding: 20px;">
  <h2 style="color: #059669;"><%= t("mailers.adoption_application.new_notice.title") %></h2>
  
  <p><%= t("mailers.adoption_application.new_notice.intro", pet_name: @pet.name) %></p>

  <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; margin: 20px 0;">
    <p style="margin: 0; font-size: 14px;"><strong><%= t("mailers.adoption_application.new_notice.applicant") %>:</strong> <%= @user.full_name %> (<%= @user.email_address %>)</p>
    <p style="margin: 8px 0 0 0; font-size: 14px;"><strong><%= t("mailers.adoption_application.new_notice.pet") %>:</strong> <%= @pet.name %></p>
  </div>

  <p><%= t("mailers.adoption_application.new_notice.call_to_action") %></p>
  <p style="font-size: 12px; color: #94a3b8; margin-top: 30px;"><%= t("mailers.shared.footer") %></p>
</div>